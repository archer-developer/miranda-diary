# Copy to .env and fill in values. Loaded at startup by internal/envfile.
# Real environment variables always take priority over values in this file.

# Shared bearer token Miranda presents to call diary tools.
# Generate with: openssl rand -hex 32
DIARY_MCP_TOKEN=

# Google AI (Gemini) API key for generating embeddings.
# Get one at https://aistudio.google.com/apikey — free tier is sufficient.
GEMINI_API_KEY=

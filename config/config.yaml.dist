# miranda-diary configuration template.
#
# This .dist file documents every available field with its built-in default
# (see internal/config.Default()) and is checked into git; it is never
# loaded directly. To configure a real deployment, copy it to
# config/config.yaml (or split it into several config/*.yaml files) and edit
# only what needs to differ — every config/*.yaml file is gitignored except
# this one. Full merge semantics (which files get loaded, in what order, how
# they combine): see internal/config's package doc comment and
# cmd/miranda-diary/main.go's configFilePaths.
#
# Secrets themselves never go in a config file, this one included — only the
# *name* of an environment variable to read them from at startup (fields
# ending in _env). See .env.example.

# http_addr: ":8789"
# auth_token_env: "DIARY_MCP_TOKEN"

# tls: Miranda's tool calls carry a per-user record_encryption_key once
# encryption is enabled for that user (see users[].encryption below), so the
# transport needs to be encrypted even though both services currently run on
# the same host over loopback. On by default. The server generates and
# reuses its own self-signed certificate at cert_file/key_file on first
# start — see internal/tlscert.EnsureSelfSigned — rather than requiring a
# CA-issued one, since this link never leaves localhost and has no public
# DNS name. hosts is the certificate's Subject Alternative Names list.
# tls:
#   enabled: true
#   cert_file: "data/tls/cert.pem"
#   key_file: "data/tls/key.pem"
#   hosts: ["127.0.0.1", "localhost"]

# database:
#   path: "data/diary.db"

# embedding:
#   api_key_env: "GEMINI_API_KEY"
#   model: "gemini-embedding-2"

# search:
#   default_limit: 10
#   max_limit: 50

# users has no built-in default and MUST be set: the closed list of
# household members every tool call's user_id is checked against (Miranda's
# own userID for each household member — see config.Config.Users). Left
# unset, the service refuses to start rather than run with no allowlist at
# all. It's a list of objects, not bare strings, so per-user settings can
# be added without another breaking config change. This repo's own template
# intentionally does not hardcode real household member ids — set the real
# list only in the server's own config.yaml (not touched by deploy, see
# CLAUDE.md), e.g.:
# users:
#   - id: "alice"
#     encryption: false  # set to true to require AES-256-GCM encryption for this user's records
#   - id: "bob"
#     encryption: false

logging:
  level: "info"
